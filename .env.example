# SQLite local (dev). Para produção, troque por uma URL de banco hospedado
# (ex: Turso) — veja o README.
DATABASE_URL="file:./dev.db"

# Assina os cookies de sessão de login. Gere o seu com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Chave mestra pra redefinir a senha de qualquer conta em /recuperar-senha,
# sem precisar de e-mail. Guarde como uma senha. Gere a sua com:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
RECOVERY_SECRET=""
