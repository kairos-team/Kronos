# Postgres (Neon, via Vercel Storage). Rode `vercel env pull .env.local`
# depois de conectar o banco no projeto para preencher esta variável.
DATABASE_URL=""

# Assina os cookies de sessão de login. Gere o seu com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Chave mestra pra redefinir a senha de qualquer conta em /recuperar-senha,
# sem precisar de e-mail. Guarde como uma senha. Gere a sua com:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
RECOVERY_SECRET=""
